{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://anvaya-backend-sukv.onrender.com/api/$1"
    },
    {
      "source": "/.well-known/(.*)",
      "destination": "https://anvaya-backend-sukv.onrender.com/.well-known/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
