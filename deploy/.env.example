# Copy to deploy/.env and set every value (python -c "import secrets; print(secrets.token_urlsafe(32))"). Secrets for the local staging stack (docker compose). Never commit this file.
POSTGRES_PASSWORD=change-me
ANUMATI_APP_DB_PASSWORD=change-me
KEYCLOAK_DB_PASSWORD=change-me
KEYCLOAK_ADMIN_PASSWORD=change-me
ANUMATI_SECRET_KEY=change-me
ANUMATI_OIDC_CLIENT_SECRET=change-me
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
ANUMATI_WEBHOOK_SECRET=change-me
ANUMATI_METRICS_TOKEN=change-me
# Password of every sample account in the Keycloak realm (see deploy/README.md for the account names).
ANUMATI_DEMO_PASSWORD=change-me
# Optional. With an AI API key, the LLM engine synthesizes Ask ANUMATI replies from verified handbook passages;
# leave empty to answer from the built-in handbook engine.
ANUMATI_AI_API_KEY=
ANUMATI_ANTHROPIC_API_KEY=
