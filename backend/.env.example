# Copy to backend/.env and change what you need. Every setting starts with ANUMATI_.
# Development works with no .env at all. The full staging stack is configured in ../deploy/docker-compose.yml.

ANUMATI_ENV=development                 # development | test | staging | production (staging/production refuse unsafe values)
ANUMATI_DATABASE_URL=sqlite+aiosqlite:///./anumati.db
# ANUMATI_DATABASE_URL=postgresql+asyncpg://anumati_app:change-me@localhost:5432/anumati   # runtime role (row-level security applies)
# ANUMATI_DATABASE_ADMIN_URL=postgresql+asyncpg://anumati:change-me@localhost:5432/anumati # owner role, migrations only
# ANUMATI_DB_POOL_SIZE=5                # per process; keep workers x (size + overflow) below PostgreSQL's max_connections
# ANUMATI_DB_MAX_OVERFLOW=5
# ANUMATI_DB_ROW_SECURITY=true

# Sign-in. dev = sample users, no password (refused in staging and production).
ANUMATI_AUTH_MODE=dev                   # dev | oidc
ANUMATI_SECRET_KEY=dev-only-secret-change-me-0123456789abcdef
ANUMATI_SESSION_MINUTES=15
ANUMATI_WEB_URL=http://localhost:5180   # where people open the website; single sign-on returns here
# ANUMATI_OIDC_ISSUER=http://localhost:8081/realms/anumati           # as the browser sees Keycloak
# ANUMATI_OIDC_INTERNAL_ISSUER=http://keycloak:8080/realms/anumati   # as the API reaches it (optional)
# ANUMATI_OIDC_CLIENT_ID=anumati-web
# ANUMATI_OIDC_CLIENT_SECRET=

ANUMATI_CORS_ORIGINS=["http://localhost:5180","http://127.0.0.1:5180"]
ANUMATI_RATE_LIMIT_PER_MINUTE=240
ANUMATI_MAX_JSON_KB=1024

ANUMATI_STORAGE_BACKEND=local           # local | s3
ANUMATI_STORAGE_DIR=./storage           # files (local) and the letter-signing key (always)
# ANUMATI_S3_ENDPOINT=storage:9000
# ANUMATI_S3_ACCESS_KEY=
# ANUMATI_S3_SECRET_KEY=
# ANUMATI_S3_BUCKET=anumati-files
# ANUMATI_S3_SECURE=true
ANUMATI_MAX_UPLOAD_MB=10
# ANUMATI_CLAMD_HOST=127.0.0.1:3310     # empty = scan reported as "not configured"; staging/production refuse uploads if it is down

ANUMATI_DRAND_URL=https://api.drand.sh/public
ANUMATI_DRAND_TIMEOUT_SECONDS=2.5

# Alerts. "log" stores the alert and writes it to the server log; real channels need provider accounts.
ANUMATI_EMAIL_MODE=log                  # log | smtp
# ANUMATI_SMTP_URL=smtp://user:password@smtp.example.gov.in:587
ANUMATI_SMS_MODE=log                    # log | http (DLT-registered gateway)
# ANUMATI_SMS_API_URL=https://sms-gateway.example/send
ANUMATI_WHATSAPP_MODE=log               # log | http (WhatsApp Business provider)
# ANUMATI_WHATSAPP_API_URL=https://whatsapp-provider.example/messages
# ANUMATI_WEBHOOK_SECRET=               # required in production: providers sign webhooks with HMAC-SHA256
# ANUMATI_BHASHINI_API_KEY=

# Ask ANUMATI. Without a key it answers from the handbook, rules, calendar and the person's own records.
# With an AI API key, the LLM engine synthesizes each reply from verified handbook sources and cites them (questions,
# matching passages and, for a signed-in person, their own files are processed by the model).
# ANUMATI_AI_API_KEY=
# ANUMATI_ANTHROPIC_API_KEY=
# ANUMATI_ASSISTANT_MODEL=neural-assistant-v1
# ANUMATI_ASSISTANT_TIMEOUT_SECONDS=25

ANUMATI_SCHEDULER_ENABLED=true
ANUMATI_SCHEDULER_INTERVAL_SECONDS=60

ANUMATI_LOG_FORMAT=text                 # text | json
# ANUMATI_METRICS_TOKEN=                # when set, /metrics needs "Authorization: Bearer <token>"

# The sample data is dated around 22 Oct 2026. Leave empty to use the real date (required in production).
ANUMATI_FIXED_TODAY=2026-10-22
ANUMATI_SEED_ON_START=true
